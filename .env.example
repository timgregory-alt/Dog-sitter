# Supabase project settings — from Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser. Used by /edit to write
# through Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# The passcode a sitter-app owner types at /edit to unlock editing. Pick
# anything memorable — this is a light deterrent, not real security.
EDIT_PASSCODE=
